---
import Layout from '../layouts/Layout.astro';

const withBase = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const normalizedPath = path.replace(/^\//, '');
  return `${base}/${normalizedPath}`;
};

const web3FormsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
---

<Layout
  title="Nature & Nurture: Southern Maryland"
  description="Nature & Nurture: Southern Maryland is a Spirituality in Nature Group (SING) located in Calvert County, MD.  A peninsula of land where the Patuxent River joins the Chesapeake Bay."
>
  <header class="site-header">
    <div class="container nav-wrap">
      <div class="brand">
        <img
          class="brand-logo"
          src={withBase('/images/NatureNurtureLogo_imageonly_v4.png')}
          alt="Nature & Nurture: Southern Maryland logo"
          loading="eager"
          decoding="async"
        />
        <div>
          <p class="eyebrow">Nature & Nurture: Southern Maryland</p>
          <p class="tagline">A Spirituality in Nature Group (SING)</p>
        </div>
      </div>
      <nav aria-label="Primary navigation">
        <ul class="nav-list">
          <li><a href="#welcome">Welcome</a></li>
            <li><a href="#about">About</a></li>
          <li><a href="#about-place">Our Shared Place</a></li>
          <li><a href="#gatherings">Gatherings</a></li>
          <li><a href="#connect">Connect</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section id="welcome" class="section hero">
      <div class="container">
        <article class="surface hero-card hero-inline">
          <h1>Welcome to Nature & Nurture: Southern Maryland</h1>
          <p>
            We gather to reconnect with the sacred through sky, shoreline, forest, and one another —
            honoring wonder, reflection, and belonging in the natural world.
          </p>
          <figure class="hero-image">
            <img
              src={withBase('/images/naturemandala.webp')}
              alt="Nature mandala arranged with flowers, leaves, and natural materials"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1600"
              height="1292"
            />
          </figure>
        </article>
      </div>
    </section>

    <section id="about" class="section">
      <div class="container">
        <h2>About Nature &amp; Nurture: Southern Maryland</h2>
        <article class="surface card about-card">
          <p>
            Nature &amp; Nurture: Southern Maryland is a welcoming
            {' '}
            <a
              href="https://www.centerforspiritualityinnature.org/spirituality-in-nature-groups"
              target="_blank"
              rel="noopener noreferrer"
            >
              Spirituality in Nature Group
            </a>
            {' '}.
            We share time and experiences in community connecting with each other and the natural place where we are gathered. We express our curiosity, creativity and reverence
            for the natural world and first peoples through shared conversation and practices/ceremonies.
          </p>
          <p>
            Belonging together, as members of the Earth and the cosmos, we invite everyone regardless of belief.
          </p>
        </article>
      </div>
    </section>

    <section id="about-place" class="section">
      <div class="container">
        <h2>Southern Maryland: Our Shared Place</h2>
        <div class="place-grid">
          <article class="surface card">
            <h3>Watershed & Geography</h3>
            <p>
              Our community sits where the Patuxent River meets the greater Chesapeake Bay watershed,
              near Lusby and the dramatic Calvert Cliffs. These Miocene-era formations hold millions of
              years of coastal history in layered sands, clays, and marine fossils.
            </p>
            <figure class="place-image">
              <img
                src={withBase('/images/watershed-geography.webp')}
                alt="Illustration of river channels flowing to the Chesapeake Bay near coastal cliffs"
                loading="lazy"
                decoding="async"
              />
            </figure>
          </article>
          <article class="surface card">
            <h3>Ecology</h3>
            <p>
              Coastal oak-pine forests, mountain laurel, and marsh edges shape this landscape. Bald
              eagles soar above creeks and coves, while fish, crabs, and other marine life sustain the
              estuary’s living web.
            </p>
            <figure class="place-image">
              <img
                src={withBase('/images/ecology.webp')}
                alt="Illustration of coastal forest and estuary wildlife habitat"
                loading="lazy"
                decoding="async"
              />
            </figure>
          </article>
          <article class="surface card">
            <h3>Indigenous Heritage</h3>
            <p>
              Placeholder for honoring the original peoples of this land, including the Piscataway Conoy
              and related Chesapeake region lineages, while acknowledging and uplifting existing tribal
              communities today.
            </p>
            <figure class="place-image">
              <img
                src={withBase('/images/indigenous-heritage.webp')}
                alt="Symbolic landscape illustration honoring Indigenous presence and relationship with land"
                loading="lazy"
                decoding="async"
              />
            </figure>
          </article>
        </div>
      </div>
    </section>

    <section id="gatherings" class="section gatherings">
      <div class="container">
        <h2>Gatherings & Calendar</h2>
        <article class="surface card gathering-details">
          <h3>Our Gatherings</h3>
          <p>
            Our gatherings begin with a warm welcome and a Seven Directions prayer.  In a circle together we 
            share and reflect on a theme, learn about and pay respect to the first peoples and ecology of the land. 
            We share a centering practice and an inspirational reading, and then a combination of quiet solo time 
            followed by a shared community activity or ceremony with the intention of cultivating our awareness of 
            this wondrous life-giving planet and honoring our active, reciprocal place within this living community.  
            We close by sharing reflections on the practices we have shared, followed by expressing gratitude for 
            ourselves, each other, and our world. 
          </p>
          <figure class="gathering-image">
            <img
              src={withBase('/images/sing_nature_mandala.webp')}
              alt="Nature mandala arranged with flowers, leaves, and natural materials"
              loading="lazy"
              decoding="async"
              width="1200"
              height="900"
            />
          </figure>
        </article>
        <div class="surface iframe-card">
          <p>Upcoming gatherings are listed below in agenda view.</p>
          <iframe
            class="calendar-embed"
            title="Nature & Nurture: Southern Maryland Gatherings Calendar"
            src="https://calendar.google.com/calendar/embed?src=748db8a7c2883d804e9257ebc7c994a01aee3781f451a68ab43d385228ac918d%40group.calendar.google.com&ctz=America%2FNew_York&mode=AGENDA&showTitle=0&showPrint=0&showTabs=0&showCalendars=0&showTz=0"
            loading="lazy"
            referrerpolicy="no-referrer"
            frameborder="0"
            scrolling="no"
            style="border: 0"
          ></iframe>
        </div>
      </div>
    </section>

    <section id="connect" class="section">
      <div class="container">
        <h2>Connect With Us</h2>
        <div class="forms-grid">
          <article class="surface card">
            <h3>Send Us a Message</h3>
            <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate>
              <p class="form-note">All fields are required.</p>

              <input type="hidden" name="access_key" value={web3FormsAccessKey} />
              <input type="hidden" name="subject" value="Message from Nature & Nurture contact form" />
              <input type="checkbox" name="botcheck" class="hidden-field" tabindex="-1" autocomplete="off" />

              <label for="name">Name *</label>
              <input id="name" name="name" type="text" required />

              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required />

              <label for="message">Message *</label>
              <textarea id="message" name="message" rows="5" required></textarea>

              <button class="button" type="submit">Send Message</button>
              <p id="form-status" role="status" aria-live="polite"></p>
            </form>
          </article>

          <article class="surface card">
            <h3>Newsletter Sign-up</h3>
            <p class="form-note">
              We use double opt-in, so after subscribing check your inbox for a confirmation email to complete
              your sign-up.
            </p>
            <div class="newsletter-embed">
              <script async src="https://eomail5.com/form/859ac880-9293-11f1-bc51-6fc09e9095d8.js" data-form="859ac880-9293-11f1-bc51-6fc09e9095d8"></script>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-wrap">
      <p>© {new Date().getFullYear()} Nature & Nurture: Southern Maryland.</p>
      <p>
        A
        {' '}
        <a
          href="https://www.centerforspiritualityinnature.org/spirituality-in-nature-groups"
          target="_blank"
          rel="noopener noreferrer"
        >
          Spirituality in Nature Group (SING)
        </a>
        {' '}in Southern Maryland.
      </p>
    </div>
  </footer>

  <script>
    const form = document.querySelector('#contact-form');
    const status = document.querySelector('#form-status');

    if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!form.checkValidity()) {
          status.textContent = 'Please complete all required fields before sending.';
          status.dataset.state = 'error';
          form.reportValidity();
          return;
        }

        const accessKey = form.querySelector('input[name="access_key"]');
        if (!(accessKey instanceof HTMLInputElement) || !accessKey.value.trim()) {
          status.textContent = 'Contact form is not configured yet. Please add your Web3Forms access key.';
          status.dataset.state = 'error';
          return;
        }

        const button = form.querySelector('button[type="submit"]');
        if (button instanceof HTMLButtonElement) {
          button.disabled = true;
          button.textContent = 'Sending...';
        }

        status.textContent = 'Sending your message...';
        status.dataset.state = '';

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: form.method,
            body: formData,
            headers: {
              Accept: 'application/json'
            }
          });

          const result = await response.json();
          if (response.ok && result.success) {
            status.textContent = 'Thanks for reaching out. Your message was sent successfully.';
            status.dataset.state = 'success';
            form.reset();
          } else {
            status.textContent = result.message || 'We could not send your message. Please try again.';
            status.dataset.state = 'error';
          }
        } catch {
          status.textContent = 'We could not send your message. Please try again in a moment.';
          status.dataset.state = 'error';
        } finally {
          if (button instanceof HTMLButtonElement) {
            button.disabled = false;
            button.textContent = 'Send Message';
          }
        }
      });
    }
  </script>

  <script>
    // Email Octopus injects the form/message markup asynchronously, so watch for the success text to appear.
    const newsletterEmbed = document.querySelector('.newsletter-embed');

    if (newsletterEmbed instanceof HTMLElement) {
      const observer = new MutationObserver(() => {
        const successMessage = newsletterEmbed.querySelector('.emailoctopus-success-message');
        const newsletterForm = newsletterEmbed.querySelector('form');
        const submitButton = newsletterForm?.querySelector('input[type="submit"]');

        if (successMessage?.textContent?.trim() && newsletterForm instanceof HTMLFormElement) {
          newsletterForm.reset();

          if (submitButton instanceof HTMLInputElement) {
            submitButton.disabled = false;
          }
        }
      });

      observer.observe(newsletterEmbed, { childList: true, subtree: true, characterData: true });
    }
  </script>
</Layout>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 2;
    backdrop-filter: blur(6px);
    background: color-mix(in oklab, var(--color-bg-alt) 82%, white);
    border-bottom: 1px solid color-mix(in oklab, var(--color-primary) 18%, white);
  }

  .nav-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0 0.4rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-logo {
    width: clamp(68px, 10vw, 104px);
    height: auto;
    display: block;
  }

  .eyebrow {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .tagline {
    margin: 0.2rem 0 0;
    color: color-mix(in oklab, var(--color-text) 80%, var(--color-primary));
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .nav-list a {
    text-decoration: none;
    font-weight: 500;
    padding: 0.3rem 0.55rem;
    border-radius: 0.35rem;
  }

  .nav-list a:hover,
  .nav-list a:focus-visible {
    background: color-mix(in oklab, var(--color-accent) 42%, white);
  }

  .hero-card {
    padding: clamp(1.5rem, 3vw, 2.4rem);
    border-left: 6px solid var(--color-accent);
  }

  .section {
    scroll-margin-top: 4.5rem;
  }

  .hero-image {
    margin: 1rem 0 0;
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: clamp(210px, 27vw, 285px);
    object-fit: cover;
    object-position: center 35%;
    border-radius: 0.65rem;
    border: 1px solid color-mix(in oklab, var(--color-primary) 18%, white);
    background: color-mix(in oklab, var(--color-bg-alt) 75%, white);
  }

  .hero-card p {
    max-width: none;
    margin-bottom: 0;
  }

  .place-grid,
  .forms-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    margin-top: 1.2rem;
  }

  .card {
    padding: 1.2rem;
  }

  .about-card {
    width: 100%;
    border-left: 6px solid var(--color-accent);
  }

  .about-card p:last-child {
    margin-bottom: 0;
  }

  .place-grid .card {
    border-left: 6px solid var(--color-primary);
  }

  .forms-grid .card {
    border-left: 6px solid var(--color-primary);
  }

  .place-image {
    margin: 1rem 0 0;
  }

  .place-image img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 0.65rem;
    border: 1px solid color-mix(in oklab, var(--color-primary) 18%, white);
    background: color-mix(in oklab, var(--color-bg-alt) 75%, white);
  }

  .gatherings {
    background: color-mix(in oklab, var(--color-bg-alt) 68%, white);
  }

  .iframe-card {
    padding: 1.2rem;
  }

  .gathering-details {
    margin-bottom: 1rem;
    border-left: 6px solid var(--color-accent);
  }

  .gathering-image {
    margin: 1rem 0 0;
  }

  .gathering-image img {
    display: block;
    width: min(100%, 684px);
    height: auto;
    margin: 0 auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.65rem;
    border: 1px solid color-mix(in oklab, var(--color-primary) 18%, white);
    background: color-mix(in oklab, var(--color-bg-alt) 75%, white);
  }

  .calendar-embed {
    width: 100%;
    height: clamp(360px, 68vh, 760px);
    border: 1px solid color-mix(in oklab, var(--color-primary) 18%, white);
    border-radius: 0.6rem;
    background: var(--color-surface);
  }

  form {
    display: grid;
    gap: 0.55rem;
  }

  input,
  textarea {
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in oklab, var(--color-primary) 24%, white);
    padding: 0.65rem 0.75rem;
    font: inherit;
    background: #fff;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid color-mix(in oklab, var(--color-accent) 75%, white);
    outline-offset: 1px;
  }

  #form-status {
    min-height: 1.2em;
    margin: 0;
    font-size: 0.95rem;
  }

  .hidden-field {
    display: none;
  }

  #form-status[data-state='error'] {
    color: #8b2f2f;
  }

  #form-status[data-state='success'] {
    color: var(--color-primary);
  }

  .form-note {
    margin: 0 0 0.15rem;
    font-size: 0.95rem;
    color: color-mix(in oklab, var(--color-text) 72%, var(--color-primary));
  }

  .newsletter-embed {
    margin-top: 0.4rem;
  }

  /* Email Octopus injects its own markup at runtime, so these rules target it via :global() and !important. */
  .newsletter-embed :global(.emailoctopus-form-wrapper) {
    display: flex !important;
    flex-direction: column !important;
  }

  .newsletter-embed :global(.emailoctopus-form-wrapper > form) {
    order: 1 !important;
  }

  .newsletter-embed :global(form) {
    display: grid !important;
    gap: 0.55rem !important;
    font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
  }

  .newsletter-embed :global(label) {
    color: var(--color-text) !important;
    font-weight: 500 !important;
  }

  .newsletter-embed :global(.emailoctopus-success-message),
  .newsletter-embed :global(.emailoctopus-error-message) {
    order: 2 !important;
    margin: 0.5rem 0 0 !important;
    text-align: center !important;
    font-size: 1.4rem !important;
    font-weight: 600 !important;
    color: #8b2f2f !important;
  }

  .newsletter-embed :global(.emailoctopus-success-message:empty),
  .newsletter-embed :global(.emailoctopus-error-message:empty) {
    display: none !important;
  }

  .newsletter-embed :global(.emailoctopus-form-row-hp) {
    display: none !important;
  }

  .newsletter-embed :global(input),
  .newsletter-embed :global(select),
  .newsletter-embed :global(textarea) {
    width: 100% !important;
    border-radius: 0.5rem !important;
    border: 1px solid color-mix(in oklab, var(--color-primary) 24%, white) !important;
    padding: 0.65rem 0.75rem !important;
    font: inherit !important;
    background: #fff !important;
    box-sizing: border-box !important;
  }

  .newsletter-embed :global(input:focus),
  .newsletter-embed :global(select:focus),
  .newsletter-embed :global(textarea:focus) {
    outline: 2px solid color-mix(in oklab, var(--color-accent) 75%, white) !important;
    outline-offset: 1px !important;
  }

  .newsletter-embed :global(button),
  .newsletter-embed :global(input[type='submit']) {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: none !important;
    border-radius: 999px !important;
    font: inherit !important;
    font-weight: 600 !important;
    cursor: pointer !important;
    padding: 0.65rem 1.1rem !important;
    background: var(--color-primary) !important;
    color: #fff !important;
  }

  .newsletter-embed :global(button:hover),
  .newsletter-embed :global(input[type='submit']:hover) {
    background: color-mix(in oklab, var(--color-primary) 86%, black) !important;
  }


  .site-footer {
    border-top: 1px solid color-mix(in oklab, var(--color-primary) 18%, white);
    background: color-mix(in oklab, var(--color-bg) 78%, white);
    padding: 1.3rem 0 1.6rem;
  }

  .footer-wrap {
    display: grid;
    gap: 0.3rem;
  }

  .footer-wrap p {
    margin: 0;
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .section {
      padding: 1.5rem 0;
    }

    .eyebrow {
      font-size: 1.1rem;
    }

    .nav-list {
      gap: 0.4rem;
    }

    .button {
      width: 100%;
    }

    .calendar-embed {
      height: clamp(320px, 62vh, 620px);
    }
  }
</style>
